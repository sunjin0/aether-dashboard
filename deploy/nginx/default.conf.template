server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # API 与前端同源，浏览器无需保存或暴露后端容器地址。
    location /api/ {
        # Keep this aligned with Spring's max-request-size so uploads reach the API.
        client_max_body_size 100m;
        resolver 127.0.0.11 ipv6=off;
        proxy_pass ${AETHER_ADMIN_UPSTREAM};
        proxy_http_version 1.1;
        # 必须是 $http_host（带端口）而不是 $host（会丢掉端口）：Tomcat 只在 Host 里
        # 有冒号时才设置 serverPort，缺端口时 Spring 会把带 Origin 的同源请求判成跨域，
        # 于是登录、上传、SSE 这些非 GET 请求全被 CORS 拦成 403 Invalid CORS request。
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Agent SSE：禁止代理缓存和响应缓冲，允许 Deep 长任务保持连接。
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 650s;
        proxy_send_timeout 650s;
        proxy_set_header X-Accel-Buffering no;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Keep the HTML entry fresh after a dashboard image release; hashed assets remain cacheable.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files /index.html =404;
    }
}
